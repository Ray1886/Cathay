{
  "name": "cathay-lounge-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic local lounge reservation and waitlist prototype",
  "type": "commonjs",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
